bootdelay=0
bootretry=1

stdin=button-kbd
stdout=vidconsole
stderr=vidconsole

blkmapcmd=blkmap create root; \
	blkmap map root 0 ${blkmap_size_r} linear ${blkmap_blk_ifname} ${blkmap_blk_dev} ${blkmap_blk_nr}

preboot=run blkmapcmd

fastboot=fastboot -l $fastboot_addr_r usb 0

bootcmd=bootefi bootmgr; pause; run menucmd

menucmd=setenv bootcmd run menucmd; bootmenu -1

fastbootcmd=echo "Fastboot Mode"; run fastboot

bootmenu_0=Boot=bootefi bootmgr; pause
bootmenu_1=Enable fastboot mode=run fastbootcmd
bootmenu_2=UEFI Maintenance Menu=eficonfig
bootmenu_3=Dump environment=printenv; pause
bootmenu_4=Board info=bdinfo; pause
bootmenu_5=Dump bootargs=fdt print /chosen bootargs; pause
bootmenu_6=Dump fdt chosen=fdt print /chosen; pause
bootmenu_7=Dump memory map=bdinfo; lmb dump all; pause
bootmenu_8=Drop to shell=setenv bootretry -1
bootmenu_9=Reset device=reset

button_cmd_0_name=Volume Down Key
button_cmd_0=run menucmd